.venv/
**/.venv/
__pycache__/
*.pyc
.pytest_cache/
.runs/
datagen/out/
data/
models/
*.npz
*.onnx
*.pt
.DS_Store
node_modules/
train_out/
# The trained models handed back from the training box ARE committed (TRAINING.md, steps 8 and 9)
!models-release*/
